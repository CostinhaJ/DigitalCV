---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Cv from '../components/Cv.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/cv';

// Projetos em destaque primeiro, depois do mais recente para o mais antigo.
// Os marcados com draft: true não aparecem.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year,
);
---

<Layout>
  <Header />

  <main id="top">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">{profile.role} · {profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="lead">{profile.tagline}</p>
        <div class="actions">
          <a class="btn primary" href="#projetos">Ver projetos</a>
          <a class="btn" href="#cv">Ler CV</a>
        </div>
      </div>
    </section>

    <Cv />

    <section id="projetos">
      <div class="container">
        <h2>Projetos <span class="count">{projects.length}</span></h2>
        <div class="grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <section id="contacto">
      <div class="container contact">
        <h2>Contacto</h2>
        <p>Quer falar comigo? Escreva-me.</p>
        <div class="actions">
          <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
          {
            profile.links.map((link) => (
              <a class="btn" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">© {new Date().getFullYear()} {profile.name}</div>
  </footer>
</Layout>

<style>
  .hero {
    padding-block: 7rem 4rem;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 5rem);
    letter-spacing: -0.04em;
  }
  .lead {
    max-width: 38rem;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    color: var(--muted);
    margin: 1.25rem 0 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .count {
    font-size: 0.5em;
    vertical-align: middle;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1em 0.6em;
    margin-left: 0.4rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
  }
  .contact p {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }
  footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
