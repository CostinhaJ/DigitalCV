---
import '../styles/global.css';
import { profile } from '../data/cv';
import { htmlLang, homePath, langs, tr, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { lang } = Astro.props;
const {
  title = `${profile.name} — ${tr(profile.role, lang)}`,
  // Ex.: "BSc Engenharia Informática · MSc Inteligência Artificial. Orientado por dados, ..."
  description = [
    profile.degrees.map((d) => `${d.level} ${tr(d.name, lang)}`).join(' · '),
    tr(profile.tagline, lang),
  ]
    .filter(Boolean)
    .join('. '),
} = Astro.props;
// Versões alternativas da página noutros idiomas (para motores de busca).
const alternates = Astro.site
  ? langs.map((l) => ({ lang: htmlLang[l], href: new URL(homePath(l), Astro.site).href }))
  : [];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
  </head>
  <body>
    <slot />
  </body>
</html>
